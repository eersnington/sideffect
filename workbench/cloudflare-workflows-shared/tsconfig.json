{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["@cloudflare/workers-types"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "sideffect": ["../../packages/sideffect/src/index.ts"],
      "sideffect/cloudflare": ["../../packages/sideffect/src/cloudflare.ts"],
      "sideffect/vite": ["../../packages/sideffect/src/vite.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src"]
}
